# ─── Supabase (Workstation project) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://uxegtdclsndoaobmrdcd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Service-role key bypasses RLS — server-side only, never NEXT_PUBLIC_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used to build password-reset / staff-invite links. Set this to this app's
# own real deployed URL, not a placeholder or another project's domain.
NEXT_PUBLIC_APP_URL=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_NOREPLY=noreply@yourdomain.example
RESEND_FROM_TEAM=admin@yourdomain.example

# ─── Paystack (Subscriptions) ─────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ─── Deployment monitoring — (tech)/deployment and /api/tech/deployments ──────
# Optional: leave unset and those widgets will show "not configured" instead
# of erroring.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ADMIN_PROJECT_ID=
EAS_ACCOUNT_TOKEN=
EAS_PROJECT_ID=

# NODE_ENV, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, VERCEL_GIT_COMMIT_SHA are
# provided automatically by Vercel at runtime — no need to set these locally.
