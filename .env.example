# ─── Supabase (Workstation project) ──────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://uxegtdclsndoaobmrdcd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── App Environment ──────────────────────────────────────────────────────────
# development | preview | production
APP_ENV=development

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to true to use mock verification (no real Smile Identity / Dojah / Termii needed)
EXPO_PUBLIC_MOCK_VERIFICATION=true

# ─── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ─── Smile Identity (NIN + Liveness) — add when account is ready ─────────────
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

# ─── Dojah (CAC Verification) — add when account is ready ────────────────────
DOJAH_APP_ID=
DOJAH_API_KEY=

# ─── Termii (SMS OTP) — add when account is ready ────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Workstation

# ─── Paystack (Subscriptions) — add when account is ready ────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
